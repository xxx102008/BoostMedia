PORT=3000
BASE_URL=http://127.0.0.1:3000

# SMTP: outgoing email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@example.com
SMTP_PASS=replace-with-mail-password
MAIL_FROM=your-mailbox@example.com

# IMAP: read the verification email
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-mailbox@example.com
IMAP_PASS=replace-with-mail-password

# Browser automation
PUPPETEER_HEADLESS=true
EMAIL_WAIT_TIMEOUT_MS=120000
